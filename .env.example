# ─── App ──────────────────────────────────────────────────────────────────
APP_NAME="Financial Advisory & Risk Intelligence"
APP_ENV=development          # development | staging | production
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# ─── Security ─────────────────────────────────────────────────────────────
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-me-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the Streamlit / web client
CORS_ORIGINS=http://localhost:8501,http://localhost:3000

# ─── MongoDB ──────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=financial_advisory
MONGODB_MIN_POOL_SIZE=5
MONGODB_MAX_POOL_SIZE=50

# ─── LLM / Embeddings ─────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional: fall back to a local sentence-transformers model when set to true
USE_LOCAL_EMBEDDINGS=false
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ─── RAG ──────────────────────────────────────────────────────────────────
VECTORSTORE_DIR=./data/vectorstore
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=4

# ─── External data ────────────────────────────────────────────────────────
NEWS_API_KEY=
FINNHUB_API_KEY=

# ─── SEC EDGAR ────────────────────────────────────────────────────────────
# Required by SEC API etiquette — set to "Your Name your.email@example.com"
SEC_USER_AGENT=

# ─── Hugging Face (optional) ──────────────────────────────────────────────
# Set to 1 to skip the network check when loading FinBERT (faster cold start
# once the model is cached in ~/.cache/huggingface/)
HF_HUB_OFFLINE=
